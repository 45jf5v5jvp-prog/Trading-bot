# =============================================================================
# keeper/.env  — server configuration for the keeper program
#
# This file lives ONLY on the server that runs the keeper. It is NOT uploaded
# to the website and is NOT committed to git (it is in .gitignore for a reason).
# =============================================================================

# ---- Chain ----
RPC_URL=https://rpc.pulsechain.com
RPC_FALLBACK=https://rpc-pulsechain.g4mm4.io
CHAIN_ID=369

# ---- Keeper identity ----
# The keeper's PUBLIC address is:  0x472ABdc5FFA9666C32c592b9B9CBc9D1b36533a7
# The line below needs that wallet's PRIVATE KEY. Paste it ONLY here, ONLY on
# the server, and NEVER anywhere else (not in chat, not in the website, not in
# git). This wallet only needs a little PLS in it for gas. It can trade; it can
# never withdraw anyone's funds.
KEEPER_PRIVATE_KEY=      # <-- paste the private key for 0x472A...33a7 here, on the server only

# Where your fees land. This is your Treasury (a public address is correct):
TREASURY=0x22B7faCA9f94ed2645364AbEe11F117B56b6469a

# ---- Contracts ----
# These two are blank until the contracts are DEPLOYED to PulseChain. After the
# deploy, paste the deployed addresses here.
VAULT_FACTORY=          # <-- fill in after deploying VaultFactory
PROBE_ADDRESS=          # <-- fill in after deploying SwapProbe

# These are the public PulseX addresses (verify each on scan.pulsechain.com):
ROUTER=0x165C3410fC91EF562C50559f7d2289fEbed552d9
FACTORY=0x29eA7545DEf87022BAdc76323F373EA1e707C523
WPLS=0xA1077a294dDE1B09bB078844df40758a5D0f9a27

# ---- Fees ----
FEE_BPS=15

# ---- Safety (leave DRY_RUN=true until you have run the doctor and watched it) ----
DRY_RUN=true
MAX_GAS_PRICE_GWEI=3000000
MAX_SLIPPAGE_BPS=150
GLOBAL_KILL=false

# ---- Cadence (seconds) ----
PRICE_POLL_SEC=60
RULE_EVAL_SEC=60
POSITION_CHECK_SEC=20
PAIR_SCAN_SEC=15
REGISTRY_REFRESH_SEC=300

# ---- Screener ----
SIM_ADDRESS=0x1111111111111111111111111111111111111111
SIM_AMOUNT_PLS=100000
HONEYPOT_MAX_LOSS_BPS=1200

# ---- Storage ----
DB_PATH=./keeper.db
LOG_LEVEL=info
