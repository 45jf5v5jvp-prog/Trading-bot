# Copy to .env.local for local development. On the server, put these in
# .env.local in the site directory (or real environment variables).
#
# ONE CODEBASE, TWO CHAINS. This site serves both the PulseChain and the
# Robinhood Chain dashboards - every difference between them is configuration,
# selected here. See lib/chain.js for the full preset each value comes from.
#
# The only REQUIRED line is the chain selector:
#
#   NEXT_PUBLIC_CHAIN=pulsechain     # the PulseChain deployment
#   NEXT_PUBLIC_CHAIN=robinhood      # the Robinhood Chain deployment
#
# (Legacy fallback: if unset, NEXT_PUBLIC_CHAIN_ID=4663 also selects the
# robinhood preset, and the default is pulsechain - so both pre-existing
# deployments keep working before this variable is even added.)
NEXT_PUBLIC_CHAIN=

# --- Optional overrides -----------------------------------------------------
# Every value below has a sensible per-chain default from the preset; set one
# only to override it for your deployment.
#
# IMPORTANT: every NEXT_PUBLIC_ variable is bundled straight into the browser
# JS by Next.js design - anyone who loads the site can read it. Never put a
# URL with a private API key in NEXT_PUBLIC_RPC_URL; use a public RPC or a
# domain-restricted key.

# NEXT_PUBLIC_RPC_URL=
# NEXT_PUBLIC_CHAIN_ID=
# NEXT_PUBLIC_VAULT_FACTORY=

# V2+V3 capable vaults (MultiVenueVault factory). Deployed on Robinhood Chain;
# set it there. Leave blank on chains where it isn't deployed - the site then
# stays on V2-only vaults.
# NEXT_PUBLIC_MULTI_VENUE_VAULT_FACTORY=

# Wrapped native token address. Both historical names are honored.
# NEXT_PUBLIC_WETH=
# NEXT_PUBLIC_WPLS=

# NEXT_PUBLIC_ROUTER=
# NEXT_PUBLIC_EXPLORER_URL=

# Required for the "Connect via WalletConnect" button (needed for any wallet
# that isn't a browser extension - Internet Money, Trust Wallet, and most
# phone wallets). Free signup at https://cloud.reown.com - create a project,
# copy its Project ID. Not chain-specific: the same ID works for both
# deployments.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Where the site's own SQLite database lives (bot config only). Defaults to
# ./site.db if unset.
SITE_DB_PATH=./site.db

# Where the KEEPER's SQLite database lives (positions, trade history) - a
# separate file from the one above, opened strictly read-only. Defaults to
# ../keeper/keeper.db, which is correct automatically when this site is
# deployed as a sibling of keeper/ in the same checkout. Only set this if
# your layout differs.
# KEEPER_DB_PATH=../keeper/keeper.db
