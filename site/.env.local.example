# Copy to .env.local for local development. On the server, set these as real
# environment variables instead (see SITE-README.md / the deploy notes in the
# repo root CLAUDE.md).
#
# IMPORTANT: every NEXT_PUBLIC_ variable here is bundled straight into the
# browser JS by Next.js design - anyone who loads the site can read it in
# their browser's dev tools. NEXT_PUBLIC_RPC_URL in particular must NOT be a
# URL with a private API key in it (e.g. the keeper's own Alchemy URL) - that
# would hand your API key to every visitor, who could then burn your quota or
# rate-limit you off your own key. Get a second, separate RPC URL for this
# specifically - either a public Robinhood Chain RPC (verify it's real and
# reliable before trusting it) or a second Alchemy/provider key restricted by
# HTTP referrer to this site's domain.

# No safe default exists for this chain (unlike PulseChain's public
# rpc.pulsechain.com) - this MUST be set before the site will work at all.
NEXT_PUBLIC_RPC_URL=
NEXT_PUBLIC_CHAIN_ID=4663
NEXT_PUBLIC_VAULT_FACTORY=0xfe0EC05B62fD5EA170Cbb40706CD088DB8E06D54
# V2+V3 capable vaults (contracts/MultiVenueVault.sol). Blank until that
# contract is actually deployed and the address verified - see repo root
# CLAUDE.md. Leaving this blank keeps the site on V2-only vaults, same as
# before this existed - not required for anything else here to work.
NEXT_PUBLIC_MULTI_VENUE_VAULT_FACTORY=
NEXT_PUBLIC_WETH=0x0Bd7D308f8E1639FAb988df18A8011f41EAcAD73
NEXT_PUBLIC_ROUTER=0x89e5db8b5aa49aa85ac63f691524311aeb649eba
# Optional. Left blank until a Robinhood Chain block explorer is independently
# verified (see keeper/src/config.ts's note on hoodexplorer.org being
# unconfirmed) - tx hashes just show as plain text with no link until this is set.
NEXT_PUBLIC_EXPLORER_URL=

# Required for the "Connect via WalletConnect" button (needed for any wallet
# that isn't a browser extension - Internet Money, Trust Wallet, and most
# phone wallets). Free signup, one-time, ~5 minutes:
#   1. Go to https://cloud.reown.com and sign up (or log in).
#   2. Create a new project. Any name is fine, e.g. "Icaria Bots".
#   3. Copy its Project ID and paste it below.
# Without this set, the injected-wallet "Connect Wallet" button still works
# fine (desktop extensions, or a wallet app's own built-in browser) - only
# the WalletConnect button needs this. The PulseChain site's project ID can be
# reused here if you already have one - it's not chain-specific.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Where the site's own SQLite database lives (bot config only). Defaults to
# ./site.db if unset.
SITE_DB_PATH=./site.db

# Where the KEEPER's SQLite database lives (positions, trade history) - a
# separate file from the one above, opened strictly read-only. Defaults to
# ../keeper/keeper.db, which is correct automatically if this site is
# deployed as a sibling of keeper/ in the same robinhood-launch-bot checkout.
# Only set this if your layout differs.
# KEEPER_DB_PATH=../keeper/keeper.db
