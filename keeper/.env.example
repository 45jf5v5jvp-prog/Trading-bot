# ---- Chain ----
# No verified default here - grab a real mainnet RPC URL from
# docs.robinhood.com/chain/connecting (Alchemy recommended over any free
# public endpoint for anything beyond light testing). Required, keeper will
# refuse to start without it.
RPC_URL=
CHAIN_ID=4663

# ---- Keeper identity ----
# Hot key. It can only call executeSwap on vaults. It cannot withdraw.
# Fund it with ETH for gas only, and rotate it if anything looks wrong.
KEEPER_PRIVATE_KEY=
TREASURY=0x0000000000000000000000000000000000000000

# ---- Contracts ----
# VaultFactory is deployed per-chain - fill this in after deploying it here,
# same Remix flow as the PulseChain bot.
VAULT_FACTORY=
# Uniswap V2 on Robinhood Chain (developers.uniswap.org/docs/protocols/v2/deployments).
ROUTER=0x89e5db8b5aa49aa85ac63f691524311aeb649eba
FACTORY=0x8bceaa40b9acdfaedf85adf4ff01f5ad6517937f
WETH=0x0Bd7D308f8E1639FAb988df18A8011f41EAcAD73

# ---- Fees ----
FEE_BPS=25

# ---- Safety ----
DRY_RUN=true
# PulseChain's gas market runs in the millions of gwei; Robinhood Chain is a
# normal Arbitrum L2 and should not need anywhere near that. This is an
# unmeasured placeholder - watch real gas prices after launch and tighten it.
MAX_GAS_PRICE_GWEI=100
MAX_SLIPPAGE_BPS=150
GLOBAL_KILL=false

# ---- Cadence (seconds) ----
PRICE_POLL_SEC=60
RULE_EVAL_SEC=60
POSITION_CHECK_SEC=20
PAIR_SCAN_SEC=15
REGISTRY_REFRESH_SEC=300

# ---- Screener ----
# The deployed SwapProbe contract - fill this in after deploying it (see
# contracts/SwapProbe.sol). Without it the Launch Bot refuses every token
# rather than buy unscreened (see src/index.ts's startup check).
PROBE_ADDRESS=
# Address used only for eth_call simulation. Never funded on chain.
SIM_ADDRESS=0x1111111111111111111111111111111111111111
# In whole ETH. This is a probe trade size, keep it small - it's simulated
# (eth_call, no real funds), but too small a probe can misjudge a thin pair.
SIM_AMOUNT_ETH=0.02
HONEYPOT_MAX_LOSS_BPS=1200

# ---- Storage ----
DB_PATH=./keeper.db
LOG_LEVEL=info

# ---- Bot config source ----
# Where the keeper reads each vault's bot settings. Leave CONFIG_API blank to
# use a local file (default ./config.json). See config.example.json.
CONFIG_API=
CONFIG_FILE=./config.json
