# Copy to .env.local for local development. On Vercel (or wherever this gets
# deployed), set these as project environment variables instead. There is no
# secret in this file - everything here is meant to be public (NEXT_PUBLIC_
# variables are bundled into the browser JS by Next.js design, and the API
# route reads this same NEXT_PUBLIC_RPC_URL for its own server-side chain
# read, so one value covers both).

NEXT_PUBLIC_RPC_URL=https://rpc.pulsechain.com
NEXT_PUBLIC_VAULT_FACTORY=0xf1971425f3F52f6E6e6058Ba7faB5eF446fc7295
NEXT_PUBLIC_WPLS=0xA1077a294dDE1B09bB078844df40758a5D0f9a27

# Required for the "Connect via WalletConnect" button (needed for any wallet
# that isn't a browser extension - Internet Money, Trust Wallet, and most
# phone wallets). Free signup, one-time, ~5 minutes:
#   1. Go to https://cloud.reown.com and sign up (or log in).
#   2. Create a new project. Any name is fine, e.g. "Icaria Bots".
#   3. Copy its Project ID and paste it below.
# Without this set, the injected-wallet "Connect Wallet" button still works
# fine (desktop extensions, or a wallet app's own built-in browser) - only
# the WalletConnect button needs this.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Where the site's own SQLite database lives (bot config only). Defaults to
# ./site.db if unset. On Vercel this needs to point at persistent storage
# (see SITE-README.md) - Vercel's own filesystem is not persistent between
# deploys.
SITE_DB_PATH=./site.db

# Where the KEEPER's SQLite database lives (positions, trade history) - a
# separate file from the one above, opened strictly read-only. Defaults to
# ../keeper/keeper.db, which is correct automatically if this site is
# deployed in the same icaria-bots/ checkout as the keeper, per
# SITE-README.md's recommendation. Only set this if your layout differs.
# KEEPER_DB_PATH=../keeper/keeper.db
