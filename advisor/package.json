{
  "name": "advisor-prototype",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Private prototype: an AI financial advisor that answers the way you answer.",
  "scripts": {
    "dev": "concurrently -n server,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --watch server/index.js",
    "dev:web": "vite",
    "build": "vite build",
    "start": "NODE_ENV=production node server/index.js",
    "eval:pushback": "node evals/pushback.mjs",
    "test": "node evals/pressure.test.mjs && node evals/retirement.test.mjs && node evals/meeting.test.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.71.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.4.11"
  }
}
