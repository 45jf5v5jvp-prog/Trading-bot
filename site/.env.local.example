# Copy to .env.local for local development. On the server, put these in
# .env.local in the site directory (or real environment variables).
#
# ONE CODEBASE, TWO CHAINS. This site serves both the PulseChain and the
# Robinhood Chain dashboards - every difference between them is configuration,
# selected here. See lib/chain.js for the full preset each value comes from.
#
# The only REQUIRED line is the chain selector:
#
#   NEXT_PUBLIC_CHAIN=pulsechain     # the PulseChain deployment
#   NEXT_PUBLIC_CHAIN=robinhood      # the Robinhood Chain deployment
#
# (Legacy fallback: if unset, NEXT_PUBLIC_CHAIN_ID=4663 also selects the
# robinhood preset, and the default is pulsechain - so both pre-existing
# deployments keep working before this variable is even added.)
NEXT_PUBLIC_CHAIN=

# --- Optional overrides -----------------------------------------------------
# Every value below has a sensible per-chain default from the preset; set one
# only to override it for your deployment.
#
# IMPORTANT: every NEXT_PUBLIC_ variable is bundled straight into the browser
# JS by Next.js design - anyone who loads the site can read it. Never put a
# URL with a private API key in NEXT_PUBLIC_RPC_URL; use a public RPC or a
# domain-restricted key.

# NEXT_PUBLIC_RPC_URL=
# NEXT_PUBLIC_CHAIN_ID=
# NEXT_PUBLIC_VAULT_FACTORY=

# V2+V3 capable vaults (MultiVenueVault factory). Leave blank on chains where
# it isn't deployed - the site then stays on V2-only vaults.
# NEXT_PUBLIC_MULTI_VENUE_VAULT_FACTORY=

# V2+V3+V4 capable vaults (MultiVenueVaultV4 factory) - the kind that can
# trade V4-only launches. Checked first: a chain with this set creates and
# detects V4-capable vaults ahead of the V2+V3 factory above. Leave blank on
# chains with no V4 deployment.
# NEXT_PUBLIC_MULTI_VENUE_V4_VAULT_FACTORY=

# Wrapped native token address. Both historical names are honored.
# NEXT_PUBLIC_WETH=
# NEXT_PUBLIC_WPLS=

# NEXT_PUBLIC_ROUTER=
# NEXT_PUBLIC_EXPLORER_URL=

# --- V3/V4 pricing and honeypot-simulation (lib/livePrice.js, lib/askIcaria.js) ---
# Leave every one of these blank on a chain with no V3/V4 deployment - each
# feature that depends on it (portfolio pricing, Ask Icaria's token lookup)
# then simply skips that venue rather than guessing an address. Match these
# to the SAME contracts the keeper's own .env points at (keeper/config.ts's
# FACTORY_V3/QUOTER_V3/POOL_MANAGER/PROBE_ADDRESS_V4/PROBE_ADDRESS_V3) - a
# mismatch here means the site and keeper disagree about what's tradeable.
# NEXT_PUBLIC_FACTORY_V3=
# NEXT_PUBLIC_QUOTER_V3=
# NEXT_PUBLIC_V3_FEE_TIERS=500,3000,10000
# NEXT_PUBLIC_POOL_MANAGER=
# NEXT_PUBLIC_PROBE_ADDRESS_V4=
# Server-only (never exposed to the browser) - the V2 and V3 SwapProbe
# deployments Ask Icaria's honeypot simulation calls. V4 reuses
# NEXT_PUBLIC_PROBE_ADDRESS_V4 above rather than a third address.
# PROBE_ADDRESS=
# PROBE_ADDRESS_V3=
# SIM_ADDRESS=0x1111111111111111111111111111111111111111
# SIM_AMOUNT_PLS=
# HONEYPOT_MAX_LOSS_BPS=1200

# Required for the "Connect via WalletConnect" button (needed for any wallet
# that isn't a browser extension - Internet Money, Trust Wallet, and most
# phone wallets). Free signup at https://cloud.reown.com - create a project,
# copy its Project ID. Not chain-specific: the same ID works for both
# deployments.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# --- Talk to Your Hunter / Ask Icaria's AI read (server-only, never exposed
# to the browser) ---
# Powers the live reply in Talk to Your Hunter (lib/hunterChat.js) and the
# plain-English read layered on top of Ask Icaria's mechanical checks. With
# no key set, both features still work fully otherwise (the message is still
# recorded, the mechanical profile is still shown) - they just report no AI
# read available rather than fabricating one. This is the SITE's own key,
# separate from (can be the same value as) the keeper's own
# ANTHROPIC_API_KEY - the keeper needs its own copy for its AI buy/exit
# gates, since site and keeper are separate processes.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Where the site's own SQLite database lives (bot config only). Defaults to
# ./site.db if unset.
SITE_DB_PATH=./site.db

# Where the KEEPER's SQLite database lives (positions, trade history) - a
# separate file from the one above, opened strictly read-only. Defaults to
# ../keeper/keeper.db, which is correct automatically when this site is
# deployed as a sibling of keeper/ in the same checkout. Only set this if
# your layout differs.
# KEEPER_DB_PATH=../keeper/keeper.db
