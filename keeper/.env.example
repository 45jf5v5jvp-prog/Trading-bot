# ---- Chain ----
# RPC_URL is used for everything except one call. RPC_FALLBACK is used only
# for prices.ts's chain-wide Swap log scan - PublicNode (and likely other
# free-tier RPCs) reject that one broad, address-less eth_getLogs call, so
# it needs an endpoint confirmed not to restrict it. If RPC_URL is already
# such an endpoint, RPC_FALLBACK is simply unused.
RPC_URL=https://pulsechain-rpc.publicnode.com
RPC_FALLBACK=https://rpc.pulsechain.com
CHAIN_ID=369

# ---- Keeper identity ----
# Hot key. It can only call executeSwap on vaults. It cannot withdraw.
# Still: fund it with PLS for gas only, and rotate it if anything looks wrong.
KEEPER_PRIVATE_KEY=
TREASURY=0x0000000000000000000000000000000000000000

# ---- Contracts ----
VAULT_FACTORY=
ROUTER=0x165C3410fC91EF562C50559f7d2289fEbed552d9
FACTORY=0x29eA7545DEf87022BAdc76323F373EA1e707C523
WPLS=0xA1077a294dDE1B09bB078844df40758a5D0f9a27

# ---- Fees ----
FEE_BPS=15

# ---- Safety ----
DRY_RUN=true
MAX_GAS_PRICE_GWEI=3000000
MAX_SLIPPAGE_BPS=150
GLOBAL_KILL=false

# ---- Cadence (seconds) ----
PRICE_POLL_SEC=60
RULE_EVAL_SEC=60
POSITION_CHECK_SEC=20
PAIR_SCAN_SEC=15
REGISTRY_REFRESH_SEC=300

# ---- Market seed (Hunter/Discovery Bot candidate pool) ----
# Minimum $ liquidity for an existing PulseX token to be added to the
# watched-token pool, on top of new launches. See marketSeed.ts.
MIN_SEED_LIQUIDITY_USD=5000
MARKET_SEED_REFRESH_HOURS=6

# ---- Screener ----
# Address used only for eth_call simulation. Never funded on chain.
SIM_ADDRESS=0x1111111111111111111111111111111111111111
SIM_AMOUNT_PLS=100000
HONEYPOT_MAX_LOSS_BPS=1200

# ---- Storage ----
DB_PATH=./keeper.db
LOG_LEVEL=info

# ---- Bot config source ----
# Where the keeper reads each vault's bot settings. Leave CONFIG_API blank to
# use a local file (default ./config.json). See config.example.json.
CONFIG_API=
CONFIG_FILE=./config.json
