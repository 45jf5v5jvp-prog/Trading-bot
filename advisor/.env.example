# Required — your Anthropic API key (https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# Passcode you type to get into the prototype. Anything you like.
ADVISOR_PASSCODE=change-me

# Voice. With none of this set, the browser's built-in voice is used — free,
# and it sounds like a GPS.
#
# VOICE_PROVIDER=local points at a speech server you run yourself. This is the
# setting that makes the voice yours rather than rented; nothing else in the app
# changes when you flip it.
VOICE_PROVIDER=
VOICE_LOCAL_URL=
VOICE_LOCAL_TOKEN=
VOICE_LOCAL_VOICE=

# Or a hosted service while you're still finding out whether the product works.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Reply speed vs. depth: low = fastest, medium/high = more careful reasoning.
ADVISOR_EFFORT=low

PORT=8787
