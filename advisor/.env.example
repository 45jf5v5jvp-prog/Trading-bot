# Required — your Anthropic API key (https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# Passcode you type to get into the prototype. Anything you like.
ADVISOR_PASSCODE=change-me

# Optional. Without it, the browser's built-in voice is used (robotic but free).
# With it, replies are spoken in a cloned voice (https://elevenlabs.io).
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Reply speed vs. depth: low = fastest, medium/high = more careful reasoning.
ADVISOR_EFFORT=low

PORT=8787
